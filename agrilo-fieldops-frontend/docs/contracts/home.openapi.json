        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "office_id": {
            "type": "string",
            "title": "Office Id"
          },
          "office_name": {
            "type": "string",
            "title": "Office Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "plots": {
            "items": {
              "$ref": "#/components/schemas/HomePlot"
            },
            "type": "array",
            "title": "Plots"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/HomeSkill"
            },
            "type": "array",
            "title": "Skills"
          },
          "model": {
            "$ref": "#/components/schemas/HomeModel"
          },
          "max_plots_per_run": {
            "type": "integer",
            "title": "Max Plots Per Run",
            "default": 5
          },
          "server_area_query": {
            "type": "boolean",
            "title": "Server Area Query",
            "default": false
          },
          "shared_conversation": {
            "type": "boolean",
            "title": "Shared Conversation",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "office_id",
          "office_name",
          "role",
          "plots",
          "skills",
          "model"
        ],
        "title": "HomeContext"
      },
      "UserResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "phone_number": {
            "type": "string",
            "title": "Phone Number"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "onboarding_completed": {
            "type": "boolean",
            "title": "Onboarding Completed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "phone_number",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "title": "UserResponse"
      },
      "HomeModel": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "gemini",
              "local"
            ],
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "execution_enabled": {
            "type": "boolean",
            "title": "Execution Enabled"
          },
          "blocked_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blocked Reason"
          },
          "plot_data_policy": {
            "type": "string",
            "title": "Plot Data Policy"
          },
          "reachability_verified": {
            "type": "boolean",
            "title": "Reachability Verified",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "configured",
          "execution_enabled",
          "blocked_reason",
          "plot_data_policy"
        ],
        "title": "HomeModel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "HomeSkill": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "blocked_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Blocked Reason"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/HomeTool"
