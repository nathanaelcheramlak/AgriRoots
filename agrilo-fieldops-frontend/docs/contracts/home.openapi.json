          "missing_optional_capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Optional Capabilities",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "available"
        ],
        "title": "HomeSkill"
      },
      "HomePlot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "area": {
            "type": "number",
            "title": "Area"
          },
          "area_unit": {
            "type": "string",
            "title": "Area Unit"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "crop": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crop"
          },
          "planting_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planting Date"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "area",
          "area_unit",
          "synthetic"
        ],
        "title": "HomePlot"
      },
      "HomeTool": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version_id": {
            "type": "string",
            "title": "Version Id"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "input_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input Schema"
          },
          "plot_scoped": {
            "type": "boolean",
            "title": "Plot Scoped"
          },
          "requires_image": {
            "type": "boolean",
            "title": "Requires Image"
          },
          "optional": {
            "type": "boolean",
            "title": "Optional"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version_id",
          "capabilities",
          "input_schema",
          "plot_scoped",
          "requires_image",
          "optional"
        ],
        "title": "HomeTool"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
