  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user"
        ],
        "title": "AuthResponse"
      },
      "Body_upload_image_api_v1_image_assets_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_upload_image_api_v1_image_assets_post"
      },
      "SkillRunRequest": {
        "properties": {
          "image_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36,
                "minLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Asset Id"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Parameters"
          },
          "task": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Task"
          },
          "plot_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Plot Ids"
          },
          "request_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Key"
          },
          "authorize_network": {
            "type": "boolean",
            "title": "Authorize Network",
            "default": false
          },
          "authorize_model": {
            "type": "boolean",
            "title": "Authorize Model",
            "default": false
          },
          "authorize_credit_use": {
            "type": "boolean",
            "title": "Authorize Credit Use",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task",
          "request_key"
        ],
        "title": "SkillRunRequest"
      },
      "LoginRequest": {
        "properties": {
          "phone_number": {
            "type": "string",
            "maxLength": 20,
            "minLength": 9,
            "title": "Phone Number"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "phone_number",
          "password"
        ],
        "title": "LoginRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
