# Explicit modes: mock uses labelled demo fixtures; http connects Home, Plugins and Skills.
# Monitoring and Outreach retain their existing local draft/demo behavior.
VITE_API_MODE=mock
# In http mode, empty means the same-origin /backend development proxy.
# Set FIELDOPS_BACKEND_URL in the Vite process to change the proxy target (default 127.0.0.1:8000).
# Hosted builds need an equivalent reverse proxy or a backend URL with explicit CORS permission.
VITE_API_BASE_URL=
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Satellite basemap matches AgroSphere's Leaflet frontend (HTTPS).
# Public upstream tile endpoint; no production availability/licensing guarantee.
VITE_SATELLITE_TILE_URL=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}
VITE_SATELLITE_ATTRIBUTION=&copy; <a href="https://www.google.com/maps">Google Maps</a>
# Developer-only: success | partial | error (restart Vite after changing)
VITE_DEMO_SCENARIO=success
