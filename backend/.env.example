# Manual backend setup: copy this file to backend/.env and start from backend/.
# scripts/demo.py uses an isolated environment and does not load this file.
DATABASE_URL=sqlite:///./agriroots.db
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters
DEBUG=false
ADVISORY_MODEL_URL=http://127.0.0.1:8081
ADVISORY_MODEL_ID=qwen3-0.6b-q8
# Optional override; default is backend/runtime/model-api-key.
# ADVISORY_MODEL_KEY_FILE=/absolute/path/to/model-api-key
ADVISORY_MODEL_REVISION=23749fefcc72300e3a2ad315e1317431b06b590a
ADVISORY_MODEL_TIMEOUT=180
ADVISORY_RUN_TIMEOUT=600
ADVISORY_TOOL_TIMEOUT=45
ADVISORY_MAX_TOOL_CALLS=32
ADVISORY_COMPUTE_COST_PER_HOUR=0
ADVISORY_AUDIO_PROVIDER=local

# Weather: the current Open-Meteo integration requires no API key.

# Optional soil integration: iSDA uses account credentials, not an API key.
# Used by legacy recommendation services, not the current advisory graph.
ISDA_USERNAME=
ISDA_PASSWORD=

# Optional legacy crop-health and Gemini integrations.
# Direct recommendation/diagnosis routes still require the officer review workflow;
# adding credentials does not enable those routes or add tools to the graph.
KINDWISE_CROP_HEALTH_API_KEY=
GEMINI_API_KEY=

# Optional SMS provider, needed for normal phone OTP registration.
SMS_ETHIOPIA_API_KEY=

# Optional cloud speech providers. Local advisory audio needs no cloud credentials.
# Set ADVISORY_AUDIO_PROVIDER=cloud above only when selecting cloud advisory audio.
# GOOGLE_APPLICATION_CREDENTIALS is the path to a service-account JSON file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
HASAB_API_KEY=

# Keep real credentials in .env or the process environment, never in this example.
