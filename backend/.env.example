# Manual backend setup: copy this file to backend/.env and start from backend/.
# scripts/demo.py uses an isolated environment and does not load this file.
DATABASE_URL=sqlite:///./agriroots.db
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_characters
DEBUG=false
ADVISORY_MODEL_URL=http://127.0.0.1:8081
ADVISORY_MODEL_ID=qwen3-0.6b-q8
# Optional override; default is backend/runtime/model-api-key.
# ADVISORY_MODEL_KEY_FILE=/absolute/path/to/model-api-key
ADVISORY_MODEL_REVISION=23749fefcc72300e3a2ad315e1317431b06b590a
ADVISORY_MODEL_TIMEOUT=180
ADVISORY_RUN_TIMEOUT=600
ADVISORY_TOOL_TIMEOUT=45
ADVISORY_MAX_TOOL_CALLS=32
ADVISORY_COMPUTE_COST_PER_HOUR=0
ADVISORY_AUDIO_PROVIDER=local

# Weather: the current Open-Meteo integration requires no API key.

# Optional soil integration: iSDA uses account credentials, not an API key.
# Used by legacy recommendation services, not the current advisory graph.
ISDA_USERNAME=
ISDA_PASSWORD=

# Optional legacy crop-health integration. The review workflow still applies.
KINDWISE_CROP_HEALTH_API_KEY=

# Registry-driven companion: explicit Gemini model and key; no guessed model ID.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
CLOUD_MODEL_DATA_POLICY=synthetic_only

# Connector configuration. Credential values belong in the authenticated,
# write-only connection credential API, not model chat or configuration packs.
APP_ENV=development
SECRET_ENCRYPTION_KEY=
# SECRET_PREVIOUS_ENCRYPTION_KEYS=[]
# REDIS_URL=redis://127.0.0.1:6379/0
LIVE_TESTS_ENABLED=false
LIVE_MODEL_TESTS_ENABLED=false
LIVE_DIAGNOSIS_TESTS_ENABLED=false
EXTERNAL_ACTIONS_ENABLED=false
CONNECTOR_MAX_TOOL_CALLS=24
CONNECTOR_MAX_PROVIDER_REQUESTS=80
CONNECTOR_MAX_CONCURRENCY=4
CONNECTOR_MAX_MODEL_TOOLS=12
CONNECTOR_MAX_FOLLOWUPS=2
CONNECTOR_RUN_SECONDS=240
# Absolute operator-owned policy file, re-read for each dispatch. When set it
# replaces OUTBOUND_ALLOWED_HOSTS. See compose.policy.yaml for a read-only mount.
# OUTBOUND_HOSTS_POLICY_FILE=/absolute/path/to/outbound-hosts.json
# OUTBOUND_ALLOWED_HOSTS=["api.open-meteo.com","power.larc.nasa.gov","api.isda-africa.com","climateserv.servirglobal.net","fpma.fao.org","www.arcgis.com","services5.arcgis.com"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Compose uses a migration owner and separate application role.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=

# Optional SMS provider, needed for normal phone OTP registration.
SMS_ETHIOPIA_API_KEY=

# Optional cloud speech providers. Local advisory audio needs no cloud credentials.
# Set ADVISORY_AUDIO_PROVIDER=cloud above only when selecting cloud advisory audio.
# GOOGLE_APPLICATION_CREDENTIALS is the path to a service-account JSON file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
HASAB_API_KEY=

# Keep real credentials in .env or the process environment, never in this example.
