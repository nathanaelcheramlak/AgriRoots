      "instructions": "Explain CHIRPS historical rainfall with source dates, area and units. The current handler supports only the previously tested synthetic Adama polygon; do not invent a farm boundary.",
      "required_capabilities": [
        "rainfall.history"
      ],
      "optional_capabilities": [
        "climate.history"
      ],
      "allowed_internal_actions": [],
      "max_followup_rounds": 2,
