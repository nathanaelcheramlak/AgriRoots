  "skills": [
    {
      "name": "weather_forecast",
      "description": "weather forecast",
      "instructions": "Explain the actual dated forecast, returned units and missing metadata. Use evidence IDs. Modelled forecasts are not field measurements.",
      "required_capabilities": [
        "weather.forecast"
      ],
      "optional_capabilities": [
        "soil.profile"
      ],
      "allowed_internal_actions": [],
      "max_followup_rounds": 2,
      "triggers": [
        "explicit_chat_request"
      ]
    },
    {
      "name": "climate_history",
      "description": "climate history",
      "instructions": "Explain dated historical NASA POWER agroclimate records and time standard. A reviewed REST or MCP provider can supply this capability; historical climate is not a forecast.",
      "required_capabilities": [
        "climate.history"
      ],
      "optional_capabilities": [],
      "allowed_internal_actions": [],
      "max_followup_rounds": 2,
      "triggers": [
