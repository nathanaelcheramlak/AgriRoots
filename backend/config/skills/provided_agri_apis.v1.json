        "explicit_chat_request"
      ]
    },
    {
      "name": "soil_profile",
      "description": "soil profile",
      "instructions": "Explain iSDA mapped soil estimates, depth, units, uncertainty and missing layers. Use the approved connection credential and authorized plot coordinates. These are not laboratory measurements.",
      "required_capabilities": [
        "soil.profile"
      ],
      "optional_capabilities": [
        "weather.forecast"
      ],
      "allowed_internal_actions": [],
      "max_followup_rounds": 2,
